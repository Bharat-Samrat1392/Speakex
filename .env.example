# Required for transcript refinement and meeting analysis (two separate LLM calls via Groq).
GROQ_API_KEY=your_groq_api_key_here

# Required for local speaker diarization via pyannote/speaker-diarization-community-1.
HUGGINGFACE_TOKEN=your_huggingface_token_here

# Optional model and compute settings.
REFINEMENT_MODEL=openai/gpt-oss-120b
ANALYSIS_MODEL=openai/gpt-oss-120b
# tiny is fastest; small is noticeably more accurate on CPU.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
# auto = use CUDA if it is actually available, otherwise CPU.
DIARIZATION_DEVICE=auto

